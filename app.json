{
  "expo": {
    "name": "Wardgo",
    "slug": "wardgo",
    "version": "1.0.0",
    "scheme": "wardgo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF6E5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.wardgo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wardgo uses your photo library so you can add pictures of your clothes. Photos stay on this device.",
          "cameraPermission": "Wardgo uses the camera so you can photograph your clothes. Photos stay on this device."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wardgo uses your approximate location to fetch today's weather for outfit suggestions."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
